# SPDX-License-Identifier: GPL-3.0-or-later
# C snippets for coc-snippets. They show up in the completion menu;
# <CR> expands, <C-j>/<C-k> jump between placeholders.

snippet main "int main(void)" b
int main(void)
{
	${0}
	return 0;
}
endsnippet

snippet mainargs "int main(int argc, char *argv[])" b
int main(int argc, char *argv[])
{
	${0}
	return 0;
}
endsnippet

snippet inc "#include <...>" b
#include <${1:stdio}.h>
endsnippet

snippet Inc "#include \"...\"" b
#include "${1:`!v expand('%:t:r')`}.h"
endsnippet

snippet guard "include guard" b
#ifndef ${1:`!v toupper(substitute(expand('%:t'), '\W', '_', 'g'))`}
#define $1

${0}

#endif /* $1 */
endsnippet

snippet for "for (i = 0; i < n; i++)" b
for (${1:size_t} ${2:i} = 0; $2 < ${3:n}; $2++) {
	${0}
}
endsnippet

snippet while "while (cond)" b
while (${1:cond}) {
	${0}
}
endsnippet

snippet if "if (cond)" b
if (${1:cond}) {
	${0}
}
endsnippet

snippet ife "if (cond) ... else" b
if (${1:cond}) {
	${2}
} else {
	${0}
}
endsnippet

snippet sw "switch (expr)" b
switch (${1:expr}) {
case ${2:value}:
	${3}
	break;
default:
	${0}
	break;
}
endsnippet

snippet st "typedef struct" b
typedef struct {
	${2}
} ${1:name_t};
endsnippet

snippet en "typedef enum" b
typedef enum {
	${2:VALUE},
} ${1:name_e};
endsnippet

snippet pr "printf(...)" w
printf("${1:%s}\n"${2:, ${3:arg}});
endsnippet

snippet epr "fprintf(stderr, ...)" w
fprintf(stderr, "${1:%s}\n"${2:, ${3:arg}});
endsnippet

snippet mal "malloc with a NULL check" b
${1:type} *${2:p} = malloc(${3:n} * sizeof(*$2));
if ($2 == NULL) {
	perror("malloc");
	${0:return -1;}
}
endsnippet

# ---- UNIX / POSIX ---------------------------------------------------------

snippet posix "feature-test macro: POSIX.1-2008" b
#define _POSIX_C_SOURCE 200809L
endsnippet

snippet die "print errno and exit" b
static void die(const char *msg)
{
	perror(msg);
	exit(EXIT_FAILURE);
}
endsnippet

snippet fork "fork with child and parent branches" b
pid_t pid = fork();
if (pid == -1) {
	perror("fork");
	${1:return -1;}
} else if (pid == 0) {
	${2:/* child */}
	_exit(0);
}
${0:/* parent */}
endsnippet

snippet waitpid "wait for a child, read its exit code" b
int status;
if (waitpid(${1:pid}, &status, 0) == -1)
	perror("waitpid");
else if (WIFEXITED(status))
	${0:printf("exit %d\n", WEXITSTATUS(status));}
endsnippet

snippet pipe "pipe(2) with an error check" b
int ${1:fds}[2];
if (pipe($1) == -1) {
	perror("pipe");
	${0:return -1;}
}
endsnippet

snippet sigaction "install a signal handler" b
struct sigaction sa = {0};
sa.sa_handler = ${1:on_signal};
sigemptyset(&sa.sa_mask);
if (sigaction(${2:SIGINT}, &sa, NULL) == -1)
	perror("sigaction");
endsnippet

snippet getopt "getopt(3) option loop" b
int opt;
while ((opt = getopt(argc, argv, "${1:hv}")) != -1) {
	switch (opt) {
	case 'h':
		${2:usage();}
		break;
	default:
		${0:return 1;}
	}
}
endsnippet

snippet getline "read a stream line by line" b
char *line = NULL;
size_t cap = 0;
while (getline(&line, &cap, ${1:stdin}) != -1) {
	${0}
}
free(line);
endsnippet

snippet tcpserver "TCP socket: bind and listen" b
int srv = socket(AF_INET, SOCK_STREAM, 0);
if (srv == -1) {
	perror("socket");
	return 1;
}
int one = 1;
setsockopt(srv, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
struct sockaddr_in addr = {
	.sin_family = AF_INET,
	.sin_port = htons(${1:8080}),
	.sin_addr.s_addr = htonl(INADDR_ANY),
};
if (bind(srv, (struct sockaddr *)&addr, sizeof(addr)) == -1
    || listen(srv, ${2:16}) == -1) {
	perror("bind/listen");
	return 1;
}
${0}
endsnippet

# ---- ESP-IDF ---------------------------------------------------------------

snippet app_main "ESP-IDF entry point with a FreeRTOS task" b
static void ${1:main_task}(void *arg)
{
	(void)arg;
	for (;;) {
		${0}
		vTaskDelay(pdMS_TO_TICKS(${2:1000}));
	}
}

void app_main(void)
{
	xTaskCreate($1, "$1", ${3:4096}, NULL, 5, NULL);
}
endsnippet
